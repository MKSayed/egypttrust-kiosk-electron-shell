# Copy to .env and adjust. electron-vite loads this automatically in dev.
# In production builds, set these as real environment variables (or bake
# per-environment builds) rather than shipping a .env file inside the app.

# "remote" (default) loads APP_REMOTE_URL. "local" loads resources/web-app/index.html
VITE_APP_LOAD_MODE=remote

VITE_APP_REMOTE_URL=https://app.example.com

# Comma-separated list of origins this window is allowed to navigate to.
# Defaults to APP_REMOTE_URL alone if unset. Include staging URLs here too
# if you build a separate staging shell.
VITE_APP_ALLOWED_ORIGINS=https://app.example.com
